# Postgres (Neon / Vercel Postgres) — required for admin persistence + enquiries
DATABASE_URL=
# Optional alias used by some Vercel Postgres setups
POSTGRES_URL=

# Admin dashboard (/admin) — httpOnly cookie session
ADMIN_DASHBOARD_SECRET=
# Fallback if ADMIN_DASHBOARD_SECRET is unset (legacy enquiries secret)
ADMIN_ENQUIRIES_SECRET=

# Enquiry email notifications (optional)
RESEND_API_KEY=
RESEND_FROM=Maze <onboarding@resend.dev>
ADMIN_EMAIL=

# Legacy Sanity Studio (/studio) — optional alongside /admin
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
