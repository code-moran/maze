# Postgres (Neon / Vercel Postgres) — required for admin persistence + enquiries
DATABASE_URL=
# Optional alias used by some Vercel Postgres setups
POSTGRES_URL=

# Public site URL (canonicals, sitemap, Open Graph). Example: https://maze-gray.vercel.app
NEXT_PUBLIC_SITE_URL=

# NextAuth (admin login)
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Optional Google OAuth — must also set an allowlist
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed to sign in with Google
ADMIN_GOOGLE_ALLOWLIST=

# Admin dashboard (/admin) — httpOnly cookie session + credentials fallback
ADMIN_DASHBOARD_SECRET=
# Fallback if ADMIN_DASHBOARD_SECRET is unset (legacy enquiries secret)
ADMIN_ENQUIRIES_SECRET=
# Used for Google allowlist fallback and enquiry notifications
ADMIN_EMAIL=

# Enquiry email notifications (optional)
RESEND_API_KEY=
RESEND_FROM=Maze <onboarding@resend.dev>

# Legacy Sanity Studio (/studio) — optional alongside /admin
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
